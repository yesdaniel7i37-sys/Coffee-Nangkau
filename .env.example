# Salin file ini menjadi .env.local (di folder utama, sejajar package.json), lalu isi nilainya.
# Untuk website live (Vercel), isi nilai yang sama di Settings > Environment Variables.

ADMIN_USERNAME=admin
# Di website live: minimal 10 karakter dan jangan diawali kata umum (admin, password, ...).
ADMIN_PASSWORD=GANTI_PASSWORD_INI
# Teks acak. Di website live: minimal 32 karakter. Cara membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=GANTI_DENGAN_TEKS_ACAK_MINIMAL_32_KARAKTER

# Alamat database PostgreSQL. Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# - Lokal:  postgresql://postgres:PASSWORD@localhost:5432/coffee_nangkau
# - Cloud (Neon dll): salin dari dashboard, biasanya berakhiran ?sslmode=require
# Password yang berisi karakter khusus (@ : / # ? %) harus di-encode, misalnya @ menjadi %40.
DATABASE_URL=postgresql://postgres:PASSWORD_POSTGRES_ANDA@localhost:5432/coffee_nangkau

# Asisten rekomendasi menu (opsional). Buat API key gratis di https://aistudio.google.com/apikey
# Tanpa key, asisten tetap berjalan dengan rekomendasi sederhana (tanpa AI).
GEMINI_API_KEY=
# Opsional: nama model. Nama model Gemini sering berganti; daftar terbaru ada di
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
